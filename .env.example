# Credenciales de Arkiv. Copiá este archivo a `.env` en la raíz del repo y completá los valores.
#
#     cp .env.example .env
#
# `app/build.gradle.kts` lo lee con el helper `readEnv()` y mete los valores en BuildConfig.
# El `.env` está gitignoreado: nunca lo commitees.
#
# Sin estas tres claves la app compila igual, pero el catálogo, los subtítulos y el seguimiento
# de episodios quedan vacíos (las llamadas responden 401).

# TMDB — catálogo de películas/series en español (api_key v3, no el token v4).
# Se saca gratis en https://www.themoviedb.org/settings/api
API_KEY=

# OpenSubtitles — subtítulos. Sí, el nombre va sin la "t": es el que espera el build.
# Se saca en https://www.opensubtitles.com/consumers
SUBITLE_API=

# Simkl — seguimiento de lo visto. https://simkl.com/settings/developer/
SIMKL_CLIENT_ID=


# --- Firma del APK de release (opcional) ---
# Solo hace falta para `./gradlew :app:assembleRelease`. Si están vacías, el APK sale SIN FIRMAR
# a propósito (no cae a la llave de debug) y no se puede instalar.
#
# Para crear tu propia llave:
#   keytool -genkeypair -v -keystore ~/.android/arkiv-release.jks -alias arkiv \
#     -keyalg RSA -keysize 4096 -validity 10950
#
# Guardá ese .jks en un lugar seguro: si lo perdés, Android no deja actualizar por encima
# ningún APK que hayas firmado con él.
RELEASE_KEYSTORE_PATH=
RELEASE_KEYSTORE_PASSWORD=
RELEASE_KEY_ALIAS=
RELEASE_KEY_PASSWORD=
